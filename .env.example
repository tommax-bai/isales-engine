ISALES_DATABASE_URL=postgresql+asyncpg://isales@localhost:5432/isales
ISALES_REDIS_URL=redis://localhost:6379/0

# Stage 4: keep all four on `mock`. Stage 5 (impl-engine-providers) and
# stage 6 (impl-engine-hardware) extend the factories.
ISALES_ENGINE_LLM_PROVIDER=mock
ISALES_ENGINE_ASR_PROVIDER=mock
ISALES_ENGINE_TTS_PROVIDER=mock
ISALES_ENGINE_TELEPHONY_MODE=mock

ISALES_ENGINE_PIPELINE_DEFAULT_TIMEOUT_MS=8000
ISALES_ENGINE_MAX_NO_PROGRESS_SECONDS=60
ISALES_ENGINE_MOCK_CONNECT_DELAY_MS=200
ISALES_ENGINE_GRACEFUL_SHUTDOWN_TIMEOUT_S=30

# Channel / queue / counter overrides (defaults match the cross-service
# contract; only override for blue/green or test isolation).
# ISALES_ENGINE_DIAL_QUEUE=engine:dial
# ISALES_ENGINE_DLQ=engine:dlq
# ISALES_ENGINE_CALL_ENDED_QUEUE=engine:worker:call-ended
# ISALES_ENGINE_CONCURRENCY_KEY=isales:concurrency:active

TZ=Asia/Shanghai
